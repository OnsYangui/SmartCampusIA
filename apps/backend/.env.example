ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+psycopg://smartcampus_app:change_me_app@localhost:5433/smartcampus

# SA-28 — authentication. At least 32 random characters, e.g.:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Optional in development (a random secret is used, so sessions end when the API restarts);
# mandatory in staging and production.
JWT_SECRET_KEY=change_me_jwt_secret
# Development only: password given to the demonstration accounts by `python -m app.seed`.
# DEMO_PASSWORD=change_me_demo
